{
  "name": "referee-dashboard",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:api": "tsc --noEmit -p tsconfig.api.json",
    "typecheck:all": "npm run typecheck && npm run typecheck:api",
    "test": "vitest run src",
    "test:sync": "vitest run src/server/sync-merge.test.ts src/server/sync-ics-utils.test.ts src/server/feed-fetch.test.ts src/lib/calendarFeedInput.test.ts src/lib/calendarEvents.test.ts src/lib/mobileDashboard.test.ts",
    "audit:prod": "node scripts/audit-production-dependencies.mjs",
    "test:e2e": "node scripts/run-playwright-smoke.mjs",
    "qa:smoke": "node scripts/run-playwright-smoke.mjs",
    "qa:release": "npm run typecheck:all && npm test && npm run lint && npm run build && npm run qa:smoke",
    "lint": "eslint .",
    "build": "tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.8",
    "node-ical": "^0.27.1",
    "papaparse": "^5.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.1",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.1",
    "@types/papaparse": "^5.3.14",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vercel/node": "^5.8.26",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "@vercel/static-config": {
      "ajv": "^8.18.0"
    },
    "esbuild": "^0.28.1",
    "minimatch": "^10.2.5",
    "path-to-regexp": "^6.3.0",
    "smol-toml": "^1.6.1",
    "undici": "^6.27.0"
  }
}
